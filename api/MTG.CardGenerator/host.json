{
  "version": "2.0",
  "extensions": {
    "durableTask": {
      "hubName": "%DurableTaskHubName%",
      "tracing": {
        "DistributedTracingEnabled": true,
        "Version":  "V2"
      }
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": false,
        "excludedTypes": "Request"
      }
    }
  }
}